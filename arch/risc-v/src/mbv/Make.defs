include common/Make.defs

# Specify our HEAD assembly file.  This will be linked as
# the first object file, so it will appear at the start of .text

HEAD_ASRC = mbv_head.S

# Specify our C code within this directory to be included

CHIP_CSRCS  = mbv_start.c mbv_irq.c mbv_irq_dispatch.c
CHIP_CSRCS += mbv_timerisr.c

ifeq ($(CONFIG_MBV_SPI0),y)
CHIP_CSRCS += mbv_spi.c
endif

ifeq ($(CONFIG_MBV_ETHLITE),y)
CHIP_CSRCS += mbv_ethlite.c
endif
