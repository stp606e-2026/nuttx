#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_BOARD_MBV_ARTY

config MBV_ARTY_SD_MOUNTPOINT
	string "SD card mount point"
	default "/mnt/sd"
	depends on MBV_SPI0 && MMCSD_SPI && FS_FAT
	---help---
		The SD card on the AXI Quad SPI (HW-125 module on Pmod JA) is
		registered as /dev/mmcsd0 and, if it holds a FAT file system,
		mounted here at boot.

endif # ARCH_BOARD_MBV_ARTY
